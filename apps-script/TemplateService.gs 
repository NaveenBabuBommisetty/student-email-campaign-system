class TemplateService {

  static findTemplate(courseCode, templateType) {
    const templates = SheetService.getTemplates();

    const template = templates.find(t =>
      t.CourseCode === courseCode &&
      t.TemplateType === templateType &&
      String(t.Active).toUpperCase() === 'TRUE'
    );

    if (!template) {
      throw new Error(
        `No active template found for ${courseCode} and ${templateType}`
      );
    }

    return template;
  }
}